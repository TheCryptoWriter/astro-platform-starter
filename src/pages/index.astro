---
import Layout from '../layouts/Layout.astro';
import ContextAlert from '../components/ContextAlert.astro';
import Markdown from '../components/Markdown.astro';

const explainer = `
An Astro website can go way beyond static pages - on the right platform.

Netlify supports not only [Streaming SSR](https://docs.astro.build/en/guides/server-side-rendering/#html-streaming) and fast [Edge Middleware](https://docs.astro.build/en/guides/middleware/), but also [on-demand revalidation](https://www.netlify.com/blog/cache-tags-and-purge-api-on-netlify/) and [stale-while-revalidate](https://www.netlify.com/blog/swr-and-fine-grained-cache-control/). 
Any page or data can be rebuilt only when needed, without site visitors ever getting a performance hit.
`;
---

<Layout title="Welcome to Astro.">
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Infographic: A Visual Guide to Modern Programming Languages</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700;900&display=swap" rel="stylesheet">
    <style>
        body {
            font-family: 'Inter', sans-serif;
        }
        .chart-container {
            position: relative;
            width: 100%;
            max-width: 800px;
            margin-left: auto;
            margin-right: auto;
            height: 350px;
            max-height: 400px;
        }
        @media (min-width: 768px) {
            .chart-container {
                height: 450px;
                max-height: 500px;
            }
        }
        .text-glow {
            text-shadow: 0 0 8px rgba(0, 191, 165, 0.7);
        }
    </style>
</head>
<body class="bg-[#002B25] text-gray-200">
    
    <!-- Palette: Vibrant & Professional (#004D40, #00796B, #00BFA5, #FFC107, #FF5722) -->
    <!-- Narrative Plan: Start with a hero section, show language domains, compare performance vs productivity, deep dive into key languages, show ecosystem strength, and visualize future trends. -->
    <!-- Visualization Plan: Use a stacked bar for domains, scatter plot for performance/productivity, radar charts for language deep dives, and a horizontal bar for ecosystem strength. A custom HTML/CSS flow chart for trends. Confirming NO SVG and NO Mermaid JS. -->

    <div class="container mx-auto p-4 md:p-8">

        <header class="text-center my-12">
            <h1 class="text-4xl md:text-6xl font-black text-white mb-4">The Modern Developer's Toolkit</h1>
            <p class="text-xl md:text-2xl text-[#00BFA5] text-glow">A Visual Guide to Today's Programming Languages</p>
            <p class="max-w-3xl mx-auto mt-4 text-gray-400">
                Choosing a programming language is a critical strategic decision. This guide synthesizes insights from an in-depth analysis of 11 major languages to visualize their strengths, applications, and future trajectories.
            </p>
        </header>

        <main class="space-y-16">
            
            <section id="language-domains" class="bg-[#004D40]/50 rounded-2xl shadow-2xl p-6 md:p-8">
                <h2 class="text-3xl font-bold text-center mb-2 text-white">Dominance by Domain</h2>
                <p class="text-center text-gray-300 mb-8 max-w-2xl mx-auto">Different languages excel in different arenas. This chart reveals which languages are the go-to choices for key technology sectors like Web Development, AI/ML, and Systems Programming.</p>
                <div class="chart-container h-[500px] md:h-[600px] max-h-[650px]">
                    <canvas id="domainsChart"></canvas>
                </div>
            </section>

            <section id="performance-productivity" class="bg-[#004D40]/50 rounded-2xl shadow-2xl p-6 md:p-8">
                <h2 class="text-3xl font-bold text-center mb-2 text-white">The Performance vs. Productivity Spectrum</h2>
                <p class="text-center text-gray-300 mb-8 max-w-2xl mx-auto">Languages often involve a trade-off between raw execution speed and developer-friendly abstraction. This spectrum plots where major languages fall, from high-performance systems languages to high-productivity scripting languages.</p>
                <div class="chart-container h-[450px] md:h-[550px] max-h-[600px]">
                    <canvas id="performanceChart"></canvas>
                </div>
            </section>
            
            <section id="language-spotlight">
                <h2 class="text-3xl font-bold text-center mb-8 text-white">Language Spotlights</h2>
                <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
                    
                    <div class="bg-[#004D40]/50 rounded-2xl shadow-2xl p-6 flex flex-col">
                        <h3 class="text-2xl font-bold text-[#00BFA5] mb-4">Python</h3>
                        <p class="text-gray-300 mb-4 flex-grow">Celebrated for its simplicity and readability, Python is the undisputed leader in data science and AI, boasting a massive ecosystem of libraries. It acts as a powerful "glue language," combining rapid development with high-performance capabilities.</p>
                        <div class="chart-container h-[300px] max-h-[300px]">
                            <canvas id="pythonRadar"></canvas>
                        </div>
                    </div>

                    <div class="bg-[#004D40]/50 rounded-2xl shadow-2xl p-6 flex flex-col">
                        <h3 class="text-2xl font-bold text-[#00BFA5] mb-4">JavaScript</h3>
                        <p class="text-gray-300 mb-4 flex-grow">The engine of the web, JavaScript's asynchronous, event-driven architecture is essential for creating interactive frontend and scalable backend applications. Frameworks like React and Node.js have solidified its full-stack dominance.</p>
                         <div class="chart-container h-[300px] max-h-[300px]">
                            <canvas id="jsRadar"></canvas>
                        </div>
                    </div>

                    <div class="bg-[#004D40]/50 rounded-2xl shadow-2xl p-6 flex flex-col">
                        <h3 class="text-2xl font-bold text-[#00BFA5] mb-4">Rust</h3>
                        <p class="text-gray-300 mb-4 flex-grow">Rust offers a paradigm shift in systems programming, guaranteeing memory safety without a garbage collector. Its ownership model prevents common bugs at compile-time, making it ideal for performance-critical and secure infrastructure.</p>
                        <div class="chart-container h-[300px] max-h-[300px]">
                            <canvas id="rustRadar"></canvas>
                        </div>
                    </div>
                </div>
            </section>

            <section id="ecosystem-strength" class="bg-[#004D40]/50 rounded-2xl shadow-2xl p-6 md:p-8">
                <h2 class="text-3xl font-bold text-center mb-2 text-white">Ecosystem & Community Strength</h2>
                <p class="text-center text-gray-300 mb-8 max-w-2xl mx-auto">A language's power is magnified by its ecosystem of libraries, frameworks, and community support. This chart ranks languages by the maturity and breadth of their available tools, a key factor for enterprise adoption and development speed.</p>
                <div class="chart-container h-[500px] md:h-[600px] max-h-[700px]">
                    <canvas id="ecosystemChart"></canvas>
                </div>
            </section>
            
            <section id="future-trends">
                <h2 class="text-3xl font-bold text-center mb-8 text-white">The Future of Development</h2>
                <p class="text-center text-gray-300 mb-12 max-w-2xl mx-auto">The industry is constantly evolving. Key trends like Microservices, AI/ML integration, and the rise of Cloud-Native architecture are reshaping how software is built and deployed across all languages.</p>
                <div class="relative wrap overflow-hidden p-10 h-full">
                    <div class="border-2-2 absolute border-opacity-20 border-gray-400 h-full border" style="left: 50%"></div>
                    
                    <div class="mb-8 flex justify-between items-center w-full right-timeline">
                        <div class="order-1 w-5/12"></div>
                        <div class="z-20 flex items-center order-1 bg-[#FFC107] shadow-xl w-8 h-8 rounded-full">
                            <h1 class="mx-auto font-semibold text-lg text-gray-800">1</h1>
                        </div>
                        <div class="order-1 bg-[#00796B] rounded-lg shadow-xl w-5/12 px-6 py-4">
                            <h3 class="mb-3 font-bold text-white text-xl">Microservices Adoption</h3>
                            <p class="text-sm leading-snug tracking-wide text-gray-300">Monolithic applications are giving way to microservices. Languages like Go, Java, and PHP are increasingly used to build small, independent, and scalable services.</p>
                        </div>
                    </div>

                    <div class="mb-8 flex justify-between flex-row-reverse items-center w-full left-timeline">
                        <div class="order-1 w-5/12"></div>
                        <div class="z-20 flex items-center order-1 bg-[#FFC107] shadow-xl w-8 h-8 rounded-full">
                            <h1 class="mx-auto text-gray-800 font-semibold text-lg">2</h1>
                        </div>
                        <div class="order-1 bg-[#00796B] rounded-lg shadow-xl w-5/12 px-6 py-4">
                            <h3 class="mb-3 font-bold text-white text-xl">Cloud-Native & Serverless</h3>
                            <p class="text-sm leading-snug tracking-wide text-gray-300">Deployment is moving to the cloud. Containerization (Docker) and orchestration (Kubernetes) are standard practice, with Go, C#, and PHP embracing serverless architectures.</p>
                        </div>
                    </div>
                    
                    <div class="mb-8 flex justify-between items-center w-full right-timeline">
                        <div class="order-1 w-5/12"></div>
                        <div class="z-20 flex items-center order-1 bg-[#FFC107] shadow-xl w-8 h-8 rounded-full">
                            <h1 class="mx-auto font-semibold text-lg text-gray-800">3</h1>
                        </div>
                        <div class="order-1 bg-[#00796B] rounded-lg shadow-xl w-5/12 px-6 py-4">
                            <h3 class="mb-3 font-bold text-white text-xl">Pervasive AI/ML Integration</h3>
                            <p class="text-sm leading-snug tracking-wide text-gray-300">While Python dominates, other languages like C#, C++, and even PHP are integrating AI/ML capabilities, either through native libraries or API connections, to power intelligent features.</p>
                        </div>
                    </div>

                    <div class="mb-8 flex justify-between flex-row-reverse items-center w-full left-timeline">
                        <div class="order-1 w-5/12"></div>
                        <div class="z-20 flex items-center order-1 bg-[#FFC107] shadow-xl w-8 h-8 rounded-full">
                            <h1 class="mx-auto text-gray-800 font-semibold text-lg">4</h1>
                        </div>
                        <div class="order-1 bg-[#00796B] rounded-lg shadow-xl w-5/12 px-6 py-4">
                            <h3 class="mb-3 font-bold text-white text-xl">Cross-Platform Expansion</h3>
                            <p class="text-sm leading-snug tracking-wide text-gray-300">The "write once, run anywhere" dream is closer than ever. .NET MAUI (C#), Kotlin Multiplatform, and Swift's server-side efforts are blurring the lines between native platforms.</p>
                        </div>
                    </div>
                </div>
            </section>
        </main>

        <footer class="text-center mt-16 py-8 border-t border-gray-700">
            <p class="text-gray-400">Data synthesized from "A Comprehensive Guide to Modern Programming Languages."</p>
            <p class="text-sm text-gray-500 mt-2">Designed as a single-page application infographic.</p>
        </footer>

    </div>

    <script>
        const palette = {
            primary: '#00BFA5',
            secondary: '#FFC107',
            accent: '#FF5722',
            dark: '#00796B',
            darker: '#004D40',
            text: '#FFFFFF'
        };

        const wrapLabel = (label, maxWidth = 16) => {
            if (label.length <= maxWidth) {
                return label;
            }
            const words = label.split(' ');
            const lines = [];
            let currentLine = '';
            for (const word of words) {
                if ((currentLine + ' ' + word).trim().length > maxWidth) {
                    lines.push(currentLine.trim());
                    currentLine = word;
                } else {
                    currentLine = (currentLine + ' ' + word).trim();
                }
            }
            if (currentLine) {
                lines.push(currentLine.trim());
            }
            return lines;
        };
        
        const tooltipTitleCallback = (tooltipItems) => {
            const item = tooltipItems[0];
            let label = item.chart.data.labels[item.dataIndex];
            if (Array.isArray(label)) {
              return label.join(' ');
            } else {
              return label;
            }
        };

        const defaultChartOptions = {
            maintainAspectRatio: false,
            responsive: true,
            plugins: {
                legend: {
                    labels: {
                        color: palette.text
                    }
                },
                tooltip: {
                    callbacks: {
                        title: tooltipTitleCallback
                    }
                }
            },
            scales: {
                y: {
                    ticks: { color: palette.text },
                    grid: { color: 'rgba(255, 255, 255, 0.1)' }
                },
                x: {
                    ticks: { color: palette.text },
                    grid: { color: 'rgba(255, 255, 255, 0.1)' }
                }
            }
        };

        const domainsData = {
            labels: ['Web Development (Frontend & Backend)', 'AI, Machine Learning & Data Science', 'Mobile App Development', 'Systems, Embedded & Game Engines'],
            datasets: [
                { label: 'Python', data: [30, 90, 5, 20], backgroundColor: '#FFC107' },
                { label: 'JavaScript', data: [95, 10, 30, 5], backgroundColor: '#FF5722' },
                { label: 'Java', data: [50, 20, 70, 40], backgroundColor: '#00BFA5' },
                { label: 'C#', data: [60, 15, 60, 60], backgroundColor: '#00796B' },
                { label: 'C++', data: [5, 25, 10, 95], backgroundColor: '#004D40' },
                { label: 'Swift', data: [10, 5, 85, 5], backgroundColor: '#a1e3d9' },
                { label: 'Kotlin', data: [20, 5, 80, 5], backgroundColor: '#f5b56e' },
            ]
        };
        new Chart(document.getElementById('domainsChart'), {
            type: 'bar',
            data: {
                labels: domainsData.labels.map(l => wrapLabel(l)),
                datasets: domainsData.datasets
            },
            options: {
                ...defaultChartOptions,
                scales: {
                    x: { stacked: true, ticks: { color: palette.text }, grid: { color: 'rgba(255, 255, 255, 0.1)' } },
                    y: { stacked: true, ticks: { color: palette.text }, grid: { color: 'rgba(255, 255, 255, 0.1)' } }
                }
            }
        });
        
        const performanceData = {
            datasets: [{
                label: 'Languages',
                data: [
                    { x: 9, y: 3, r: 25, label: 'Python' },
                    { x: 8, y: 5, r: 20, label: 'JavaScript' },
                    { x: 6, y: 7, r: 18, label: 'Java' },
                    { x: 4, y: 9, r: 15, label: 'Go' },
                    { x: 2, y: 10, r: 16, label: 'Rust' },
                    { x: 3, y: 9.5, r: 17, label: 'C++' },
                    { x: 7, y: 4, r: 12, label: 'Ruby' },
                    { x: 5, y: 8, r: 14, label: 'C#' },
                    { x: 6, y: 7.5, r: 13, label: 'Swift' },
                ],
                backgroundColor: 'rgba(0, 191, 165, 0.7)',
                borderColor: '#00BFA5'
            }]
        };
        new Chart(document.getElementById('performanceChart'), {
            type: 'bubble',
            data: performanceData,
            options: {
                 ...defaultChartOptions,
                 plugins: {
                    legend: { display: false },
                    tooltip: {
                        callbacks: {
                            label: function(context) {
                                const item = context.raw;
                                return `${item.label}: (Productivity: ${item.x}, Performance: ${item.y})`;
                            }
                        }
                    }
                 },
                 scales: {
                    y: { 
                        ...defaultChartOptions.scales.y,
                        title: { display: true, text: 'Raw Performance & Low-Level Control', color: palette.text, font: {size: 14} }
                    },
                    x: {
                        ...defaultChartOptions.scales.x,
                        title: { display: true, text: 'Developer Productivity & Abstraction', color: palette.text, font: {size: 14} }
                    }
                 }
            }
        });
        
        const radarOptions = {
            ...defaultChartOptions,
            scales: {
                r: {
                    angleLines: { color: 'rgba(255, 255, 255, 0.2)' },
                    grid: { color: 'rgba(255, 255, 255, 0.2)' },
                    pointLabels: { color: palette.text, font: { size: 12 } },
                    ticks: {
                        display: false,
                        backdropColor: 'transparent'
                    },
                    suggestedMin: 0,
                    suggestedMax: 10
                }
            },
            plugins: {
                legend: { display: false }
            }
        };

        const createRadarChart = (id, data, color) => {
            new Chart(document.getElementById(id), {
                type: 'radar',
                data: {
                    labels: ['Performance', 'Ecosystem', 'Beginner-Friendly', 'Web Dev', 'Concurrency'],
                    datasets: [{
                        label: id.replace('Radar', ''),
                        data: data,
                        backgroundColor: `rgba(${parseInt(color.slice(1,3),16)}, ${parseInt(color.slice(3,5),16)}, ${parseInt(color.slice(5,7),16)}, 0.4)`,
                        borderColor: color,
                        pointBackgroundColor: color
                    }]
                },
                options: radarOptions
            });
        };

        createRadarChart('pythonRadar', [4, 10, 9, 7, 6], palette.secondary);
        createRadarChart('jsRadar', [6, 9, 7, 10, 8], palette.accent);
        createRadarChart('rustRadar', [10, 6, 2, 5, 10], palette.primary);

        const ecosystemData = {
            labels: ['Python', 'JavaScript', 'Java', 'C#', 'C++', 'PHP', 'Go', 'Ruby', 'Swift', 'Rust', 'Kotlin'],
            datasets: [{
                label: 'Relative Ecosystem Strength',
                data: [95, 93, 90, 85, 88, 75, 70, 68, 80, 65, 82].sort((a,b) => b-a),
                backgroundColor: [palette.primary, palette.dark, palette.secondary, palette.accent, '#0097A7', '#F57C00', '#4CAF50', '#D32F2F', '#7B1FA2', '#689F38', '#AFB42B'].sort(() => 0.5 - Math.random()),
            }]
        };
        const sortedEcosystem = [...ecosystemData.datasets[0].data].map((value, index) => ({label: ecosystemData.labels[index], value})).sort((a,b) => b.value-a.value);

        new Chart(document.getElementById('ecosystemChart'), {
            type: 'bar',
            data: {
                labels: sortedEcosystem.map(d => d.label),
                datasets: [{...ecosystemData.datasets[0], data: sortedEcosystem.map(d => d.value)}]
            },
            options: {
                ...defaultChartOptions,
                indexAxis: 'y',
                plugins: {
                    legend: {
                        display: false
                    }
                }
            }
        });
    </script>
</body>
</html>

</Layout>
